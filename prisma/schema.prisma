// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl dihapus karena Anda menggunakan Database Standar
}

// ==========================================
// 1. ENUMS (Tipe Data Tetap)
// ==========================================

enum UserRole {
  ADMIN
  CLIENT
  USHER
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
}

// ==========================================
// 2. AUTH MODELS (NextAuth / Auth.js)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CLIENT)
  
  accounts      Account[]
  sessions      Session[]
  
  // Relasi ke Invitation (Satu user bisa punya banyak undangan, misal: Resepsi Jakarta & Bali)
  invitations   Invitation[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 3. BUSINESS MODELS (Undangan & Tamu)
// ==========================================

model Invitation {
  id            String   @id @default(cuid())
  slug          String   @unique // URL Undangan: evory.com/slug
  isActive      Boolean  @default(true)
  
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id])
  
  // --- DATA MEMPELAI ---
  groomName     String
  groomNick     String
  groomFather   String?
  groomMother   String?
  groomImageUrl String?
  
  brideName     String
  brideNick     String
  brideFather   String?
  brideMother   String?
  brideImageUrl String?
  
  // --- DATA ACARA ---
  eventDate     DateTime
  eventTime     String   @default("08:00 WIB - Selesai")
  location      String
  mapUrl        String?
  
  // --- ASET DIGITAL & KONFIGURASI ---
  coverImageUrl String?
  musicUrl      String?
  gallery       String[] // Array URL Foto Gallery
  themeConfig   Json?    // Simpan warna/font custom disini
  
  // --- RELASI ---
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  
  guests        Guest[]
  wishes        Wish[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
}

model Guest {
  id                String     @id @default(cuid())
  
  // Identitas Tamu
  name              String
  category          String?    // VIP, Keluarga, Teman Kantor
  guestCode         String     @unique // Kode unik QR Code (misal: G-12345)
  whatsapp          String?
  
  // RSVP & Kehadiran
  rsvpStatus        RsvpStatus @default(PENDING)
  pax               Int        @default(1) // Jumlah tamu yang akan datang (Konfirmasi RSVP)
  totalPaxAllocated Int        @default(1) // Jatah kuota undangan (Max Pax)
  
  // Check-In (Buku Tamu Digital)
  isCheckedIn       Boolean    @default(false)
  checkInTime       DateTime?

  // Relasi
  invitationId      String
  invitation        Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  
  wishes            Wish[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Wish {
  id           String     @id @default(cuid())
  message      String     @db.Text
  senderName   String?    // Nama pengirim (jika guest tidak login)
  
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  
  guestId      String?
  guest        Guest?     @relation(fields: [guestId], references: [id])
  
  createdAt    DateTime   @default(now())
}

// ==========================================
// 4. TEMPLATE MANAGEMENT (Katalog Desain)
// ==========================================

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String     // Javanese, Modern, Minimalist
  slug        String     @unique // javanese-series
  description String?
  
  templates   Template[] // Relasi One-to-Many
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Template {
  id          String           @id @default(cuid())
  name        String           // Jvn-01 (Kraton)
  slug        String           @unique // jvn-01 (Ini yang dipakai di URL)
  description String?          // Deskripsi singkat

  invitations Invitation[]
  
  // Tampilan di Katalog (Frontend)
  thumbnail   String           // URL Gambar Preview
  previewUrl  String?          // Link Demo Undangan
  previewText String?          // Teks singkatan (JVN)
  bgColor     String?          // Kode warna bg (bg-stone-900)
  textColor   String?          // Kode warna text (text-gold)

  // Status
  isActive    Boolean          @default(true)
  isPremium   Boolean          @default(false)
  
  // Relasi
  categoryId  String
  category    TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}