generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String                     @unique
  logo                     String?
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  customDiscountRate       Int?
  walletBalance            Int                        @default(0)
  projects                 Project[]
  templates                Template[]
  walletTransactions       WalletTransaction[]
  members                  WorkspaceMember[]
  pricingOverrides         WorkspacePricingOverride[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(STAFF)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model PartnerApplication {
  id           String            @id @default(cuid())
  userId       String            @unique
  agencyName   String
  portfolioUrl String?
  location     String
  status       ApplicationStatus @default(PENDING)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id])
}

model User {
  id                String              @id @default(cuid())
  email             String?             @unique
  password          String?
  name              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  emailVerified     DateTime?
  image             String?
  systemRole        SystemRole          @default(WAITING)
  accounts          Account[]
  checkInsPerformed Guest[]             @relation("UsherCheckIns")
  updatesPerformed  Guest[]             @relation("UsherUpdates")
  application       PartnerApplication?
  sessions          Session[]
  workspaces        WorkspaceMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                  String          @id @default(cuid())
  slug                String          @unique
  title               String
  isActive            Boolean         @default(true)
  eventType           EventType       @default(WEDDING)
  activeModules       ServiceModule[]
  workspaceId         String
  packageTier         PackageTier     @default(ESSENTIAL)
  templateId          String?
  eventMetadata       Json?
  themeConfig         Json?
  gallery             String[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  paymentStatus       PaymentStatus   @default(UNPAID)
  publishedAt         DateTime?
  clientEmail         String?
  clientName          String?
  clientPhone         String?
  clientPin           String?
  agencyCost          Int             @default(0)
  clientInvoiceAmount Int             @default(0)
  guests              Guest[]
  template            Template?       @relation(fields: [templateId], references: [id])
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wishes              Wish[]

  @@index([slug])
  @@index([workspaceId])
}

model Guest {
  id                String     @id @default(cuid())
  name              String
  whatsapp          String?
  category          String?
  guestCode         String     @unique
  checkInTime       DateTime?
  rsvpStatus        RsvpStatus @default(PENDING)
  pax               Int        @default(1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  checkInPin        String?
  checkedInById     String?
  isCheckedIn       Boolean    @default(false)
  lastUpdatedById   String?
  projectId         String
  totalPaxAllocated Int        @default(1)
  dietaryNotes      String?
  checkedInBy       User?      @relation("UsherCheckIns", fields: [checkedInById], references: [id])
  lastUpdatedByUser User?      @relation("UsherUpdates", fields: [lastUpdatedById], references: [id])
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wishes            Wish[]
}

model Wish {
  id         String   @id @default(cuid())
  message    String
  guestId    String?
  createdAt  DateTime @default(now())
  projectId  String
  senderName String?
  guest      Guest?   @relation(fields: [guestId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  isFeatured  Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  templates   Template[]
}

model Template {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  isFeatured     Boolean          @default(false)
  tier           PackageTier      @default(ESSENTIAL)
  workspaceId    String?
  thumbnail      String
  previewUrl     String?
  previewText    String?
  bgColor        String?
  textColor      String?
  isActive       Boolean          @default(true)
  categoryId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assetsConfig   Json?
  baseModel      String?
  colorBg        String?
  colorPrimary   String?
  colorSecondary String?
  fontBody       String?
  fontHeading    String?
  renderMode     String           @default("DYNAMIC")
  projects       Project[]
  category       TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspace      Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SystemPricing {
  id                       String                     @id @default(cuid())
  service                  ServiceModule?
  tier                     PackageTier?
  name                     String
  basePrice                Int                        @default(0)
  publicPrice              Int                        @default(0)
  bundleItems              Json?
  description              String?
  isActive                 Boolean                    @default(true)
  isBundle                 Boolean                    @default(false)
  order                    Int                        @default(0)
  isConsultation           Boolean                    @default(false)
  workspacePricingOverrides WorkspacePricingOverride[]
}

model WalletTransaction {
  id          String          @id @default(cuid())
  workspaceId String
  projectId   String?
  amount      Int
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspacePricingOverride {
  id              String        @id @default(cuid())
  workspaceId     String
  systemPricingId String
  markupPrice     Int?
  customName      String?
  isPublished     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  systemPricing   SystemPricing @relation(fields: [systemPricingId], references: [id], onDelete: Cascade)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, systemPricingId])
}

enum SystemRole {
  SUPERADMIN
  USER
  WAITING
}

enum WorkspaceRole {
  OWNER
  ADMIN
  STAFF
  USHER
}

enum PackageTier {
  ESSENTIAL
  PRESTIGE
  ROYAL
  CUSTOM
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
}

enum ServiceModule {
  ONLINE_INVITATION
  RSVP_VENUE_SYSTEM
  CONTENT_CREATION
  WHATSAPP_BLAST
}

enum EventType {
  WEDDING
  CORPORATE
  BIRTHDAY
  CUSTOM
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
  CANCELLED
}

enum TransactionType {
  TOPUP
  PAYMENT
  REFUND
}
