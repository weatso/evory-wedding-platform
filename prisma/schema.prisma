generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. ENUMS (Tipe Data Tetap)
// ==========================================

// Peran di tingkat Aplikasi Induk (Evory)
enum SystemRole {
  SUPERADMIN  // Anda (Pusat). Memiliki akses tak terbatas ke semua entitas.
  USER        // Semua orang lain (Pemilik Partner, Staf Partner, Klien)
}

// Peran di dalam sebuah Workspace/Agensi
enum WorkspaceRole {
  OWNER       // Pemilik Agensi Partner (Bisa atur tagihan & tambah staf)
  ADMIN       // Manajer (Bisa buat proyek & atur tamu)
  STAFF       // Karyawan (Hanya bisa atur tamu)
  USHER       // Penjaga pintu (Akses sangat terbatas hanya untuk scan QR)
}

enum PackageTier {
  ESSENTIAL
  PRESTIGE
  ROYAL
  CUSTOM
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
}

enum ServiceModule {
  ONLINE_INVITATION
  RSVP_VENUE_SYSTEM
  CONTENT_CREATION
  WHATSAPP_BLAST
}

enum EventType {
  WEDDING
  CORPORATE
  BIRTHDAY
  CUSTOM
}

// ==========================================
// 2. AUTH MODELS (NextAuth / Auth.js)
// ==========================================

model Workspace {
  id          String   @id @default(cuid())
  name        String   // Misal: "Evory Internal", "Radeva WO", "WCC"
  slug        String   @unique // Misal: "evory", "radeva", "wcc" (Untuk URL)
  logo        String?
  
  tier        PackageTier @default(ESSENTIAL)
  isActive    Boolean     @default(true)

  members     WorkspaceMember[]
  projects    Project[]
  templates   Template[] // TAMBAHKAN BARIS INI

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  role        WorkspaceRole @default(STAFF)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, workspaceId]) // Satu orang tidak bisa gabung 2x di workspace yang sama
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  systemRole    SystemRole @default(USER) // Pengganti UserRole lama

// Relasi ke banyak Workspace
  workspaces    WorkspaceMember[]

  accounts      Account[]
  sessions      Session[]

  checkInsPerformed Guest[] @relation("UsherCheckIns")
  updatesPerformed  Guest[] @relation("UsherUpdates")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 3. BUSINESS MODELS (Proyek, Tamu, & Modul)
// ==========================================

model Project {
  id            String          @id @default(cuid())
  slug          String          @unique 
  title         String          
  isActive      Boolean         @default(true)

  eventType     EventType       @default(WEDDING)
  activeModules ServiceModule[] 

  // KUNCI MULTI-TENANCY: Proyek ini milik Workspace, BUKAN User
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  packageTier   PackageTier     @default(ESSENTIAL)
  
  templateId    String?
  template      Template?       @relation(fields: [templateId], references: [id])
  
  // SEMUA DATA SPESIFIK ACARA MASUK KE SINI (JSON)
  // Tidak ada lagi musicUrl, coverImageUrl, atau checkInPin di tingkat akar.
  eventMetadata Json?           
  themeConfig   Json?    
  gallery       String[] 
  
  guests        Guest[]
  wishes        Wish[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([slug])
  @@index([workspaceId])
}

model Guest {
  id                String     @id @default(cuid())
  
  name              String
  category          String?    
  guestCode         String     @unique 
  whatsapp          String?
  
  rsvpStatus        RsvpStatus @default(PENDING)
  pax               Int        @default(1) 
  totalPaxAllocated Int        @default(1) 
  
  isCheckedIn       Boolean    @default(false)
  checkInTime       DateTime?
  checkInPin        String?    
  
  checkedInById     String?    
  checkedInBy       User?      @relation("UsherCheckIns", fields: [checkedInById], references: [id])
  
  lastUpdatedById   String?    
  lastUpdatedByUser User?      @relation("UsherUpdates", fields: [lastUpdatedById], references: [id])

  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  wishes            Wish[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Wish {
  id           String     @id @default(cuid())
  message      String     @db.Text
  senderName   String?    
  
  // RELASI DIPERBAIKI: Mengarah ke Project
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  guestId      String?
  guest        Guest?     @relation(fields: [guestId], references: [id])
  
  createdAt    DateTime   @default(now())
}

// ==========================================
// 4. TEMPLATE MANAGEMENT (Katalog Desain)
// ==========================================

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String     
  slug        String     @unique 
  description String?

  isFeatured  Boolean    @default(false)
  sortOrder   Int        @default(0) 
  
  templates   Template[] 
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Template {
  id          String           @id @default(cuid())
  name        String           
  slug        String           @unique 
  description String?          

  isFeatured  Boolean          @default(false)
  tier        PackageTier      @default(ESSENTIAL)

  // RELASI KEPEMILIKAN TEMPLATE DIPERBAIKI (Milik Workspace, bukan User)
  workspaceId String?          
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // RELASI DIPERBAIKI: Mengarah ke Project
  projects    Project[]
  
  thumbnail   String           
  previewUrl  String?          
  previewText String?          
  bgColor     String?          
  textColor   String?          

  isActive    Boolean          @default(true)
  
  categoryId  String
  category    TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}